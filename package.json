{
  "name": "algzzar-portfolio-system",
  "version": "1.0.0",
  "description": "Luxury Cinematic Portfolio System — Full Stack",
  "main": "algzzar-portfolio-system/backend/server.js",
  "type": "module",
  "scripts": {
    "build": "cd algzzar-portfolio-system/backend && npm install",
    "build:cf": "npm install && cd algzzar-portfolio-system/backend && npm install",
    "start": "cd algzzar-portfolio-system/backend && npm start",
    "dev": "cd algzzar-portfolio-system/backend && npm run dev",
    "dev:cf": "wrangler dev",
    "deploy:cf": "wrangler publish",
    "test": "cd algzzar-portfolio-system/backend && npm test",
    "cf:login": "wrangler login",
    "cf:init": "wrangler init --name algzzar-portfolio-system"
  },
  "dependencies": {
    "itty-router": "^4.0.0",
    "wrangler": "^3.39.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0"
  },
  "keywords": [
    "portfolio",
    "cms",
    "backend",
    "frontend",
    "cloudflare",
    "workers"
  ],
  "author": "Ahmed Algzzar",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
