# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/algzzar_portfolio
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/algzzar_portfolio

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin credentials (used for first-time seeding)
ADMIN_EMAIL=admin@algzzar.com
ADMIN_PASSWORD=Admin@123

# Frontend URLs (for CORS)
PORTFOLIO_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:4000
